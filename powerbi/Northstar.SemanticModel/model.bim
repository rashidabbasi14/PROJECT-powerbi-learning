        "lineageTag": "040bb7b0-1dc4-47da-b92e-a779824b3204",
        "measures": [
          {
            "name": "Scheduled Shifts",
            "expression": "COALESCE(COUNTROWS(Attendance),0)",
            "formatString": "0",
            "lineageTag": "de792ad0-3caf-4fc4-a356-18aa7e174b5f"
          },
          {
            "name": "Present Shifts",
            "expression": "COALESCE(CALCULATE(COUNTROWS(Attendance),Attendance[status]=\"Present\"),0)",
            "formatString": "0",
            "lineageTag": "27e662fa-803e-4e50-8150-848151966f28"
          },
          {
            "name": "Absent Shifts",
            "expression": "COALESCE(CALCULATE(COUNTROWS(Attendance),Attendance[status]=\"Absent\"),0)",
            "formatString": "0",
            "lineageTag": "c1ced829-8cd8-4772-9c84-c5ac94b68135"
          },
          {
            "name": "Leave Shifts",
            "expression": "COALESCE(CALCULATE(COUNTROWS(Attendance),Attendance[status]=\"Leave\"),0)",
            "formatString": "0",
            "lineageTag": "48d843ef-e1c9-4cb8-9f9d-fb8375a0c346"
          },
          {
            "name": "Attendance Rate",
            "expression": "DIVIDE([Present Shifts],[Scheduled Shifts])",
            "formatString": "0.0%",
            "lineageTag": "ba155baf-db54-4a37-8260-80d7c5d0aeca"
          },
          {
            "name": "Worked Hours",
            "expression": "COALESCE(SUM(Attendance[workedHours]),0)",
            "formatString": "0.0",
            "lineageTag": "fab24a94-ff80-4a69-9f1d-281099b39e26"
          },
          {
            "name": "Scheduled Hours",
            "expression": "COALESCE(SUM(Attendance[scheduledHours]),0)",
            "formatString": "0.0",
            "lineageTag": "8215cf74-9745-4050-baa0-60657677326e"
          },
          {
            "name": "Overtime Hours",
            "expression": "COALESCE(SUM(Attendance[overtimeHours]),0)",
            "formatString": "0.0",
            "lineageTag": "b16ef367-3178-4001-a821-45e85031f952"
          },
          {
            "name": "Late Minutes",
            "expression": "COALESCE(SUM(Attendance[lateMinutes]),0)",
            "formatString": "0",
            "lineageTag": "cca88b77-bd5f-4d15-bfde-7f1255a573f6"
          },
          {
            "name": "Revenue",
            "expression": "COALESCE(SUM(RepairOrders[total]),0)",
            "formatString": "$#,0",
            "lineageTag": "19a4633c-f2d4-4387-9e3f-e76f002b6d06"
          },
          {
            "name": "Gross Profit",
            "expression": "COALESCE(SUM(RepairOrders[grossProfit]),0)",
            "formatString": "$#,0",
            "lineageTag": "4f218d18-09c7-45f5-9a85-0ac448b9ddfc"
          },
          {
            "name": "Repair Orders",
            "expression": "COALESCE(COUNTROWS(RepairOrders),0)",
            "formatString": "0",
            "lineageTag": "1ef952dd-ee84-4d4d-8ca4-c86d4d9f46c8"
          },
          {
            "name": "Average Invoice",
            "expression": "DIVIDE([Revenue],[Repair Orders])",
            "formatString": "$#,0",
            "lineageTag": "f6ed12ef-89c8-456d-8b69-0c0846291bc7"
          },
          {
            "name": "Billed Hours",
            "expression": "COALESCE(SUM(RepairOrders[laborHours]),0)",
            "formatString": "0.0",
            "lineageTag": "8e172853-4bc6-415c-9663-f1a882813c0e"
          }
        ],
